# Shared
NODE_ENV=development

# API
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
FUEL_PRICE_PETROL_INR=105
FUEL_PRICE_DIESEL_INR=94

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=travel_planner
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/travel_planner?schema=public

# Auth (required). Generate with: openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300
# Creating trips, generating plans, quote requests and reviews (per client).
WRITE_RATE_LIMIT_PER_MINUTE=20
# Set to 'true' (or a hop count) when running behind a load balancer
TRUST_PROXY=

# Media uploads (local disk driver). The public base can be a CDN or '/uploads' behind the SSR proxy.
MEDIA_STORAGE_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Text messages for phone verification: 'log' (development only) or 'twilio'
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Road routing: 'estimate' (offline, straight-line x 1.35) or 'osrm'.
# The public OSRM demo server is fine for development but not for production traffic:
# run your own OSRM (India extract) and point OSRM_BASE_URL at it.
ROUTING_PROVIDER=estimate
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=4000
ROUTING_CACHE_DAYS=30

# Housekeeping (expire stale quotes, prune old OTPs, refresh tokens and cached routes). 0 turns it off.
MAINTENANCE_INTERVAL_MINUTES=60

# Web (SSR server)
SITE_URL=http://localhost:4000
ALLOWED_HOSTS=localhost
SSR_API_BASE_URL=http://localhost:3000/api/v1
# Optional: forward /api and /uploads to the API so the browser uses one origin
API_PROXY_TARGET=
