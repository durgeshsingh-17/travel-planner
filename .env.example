# Shared
NODE_ENV=development

# API
API_PORT=3000
API_CORS_ORIGIN=http://localhost:4200
FUEL_PRICE_PETROL_INR=105
FUEL_PRICE_DIESEL_INR=94

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=travel_planner
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:password@localhost:5432/travel_planner?schema=public

# Auth (required). Generate with: openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300
# Set to 'true' (or a hop count) when running behind a load balancer
TRUST_PROXY=
