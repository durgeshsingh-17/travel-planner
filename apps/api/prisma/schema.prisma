generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleType {
  BIKE
  CAR
  EV
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
}

enum PlaceCategory {
  ATTRACTION
  FOOD
  CAFE
  HOTEL
  VIEWPOINT
  FUEL
  HOSPITAL
  MECHANIC
  PARKING
  ACTIVITY
}

enum TravelMode {
  BIKE
  CAR
  BUS
  FLIGHT
}

enum TripStatus {
  DRAFT
  GENERATED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TripActivityType {
  TRAVEL
  MEAL
  SIGHTSEEING
  CHECK_IN
  CHECK_OUT
  BREAK
  ACTIVITY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TagKind {
  THEME
  ACTIVITY
  AUDIENCE
  SEASON
}

enum MonthRating {
  GOOD
  OK
  AVOID
}

enum ReachMode {
  ROAD
  TRAIN
  AIR
  BUS
}

enum PackageTierLevel {
  BUDGET
  MID_RANGE
  PREMIUM
  LUXURY
}

/// Indian hotel meal plans: room only, breakfast, breakfast + one meal, all meals.
enum MealPlan {
  EP
  CP
  MAP
  AP
}

enum InclusionType {
  INCLUSION
  EXCLUSION
}

enum PolicyKind {
  CANCELLATION
  PAYMENT
  CHILD
  GENERAL
}

enum QuoteRequestStatus {
  NEW
  ROUTED
  QUOTED
  ACCEPTED
  CLOSED
  EXPIRED
  CANCELLED
}

enum QuoteRoutingStatus {
  NOTIFIED
  VIEWED
  DECLINED
  QUOTED
}

enum QuoteStatus {
  SENT
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TravellerType {
  SOLO
  COUPLE
  FAMILY
  FRIENDS
  BUSINESS
}

enum OtpPurpose {
  VERIFY_PHONE
}

enum UserRole {
  TRAVELLER
  AGENT
  EDITOR
  ADMIN
}

enum TravelPace {
  RELAXED
  BALANCED
  PACKED
}

enum TripVisibility {
  PRIVATE
  UNLISTED
}

enum SavedItemType {
  TRIP
}

enum TravellerGender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  email           String         @unique
  phone           String?
  avatarUrl       String?
  passwordHash    String?
  role            UserRole       @default(TRAVELLER)
  profile         UserProfile?
  refreshTokens   RefreshToken[]
  trips           Trip[]
  vehicles        UserVehicle[]
  savedItems      SavedItem[]
  phoneVerifiedAt DateTime?
  quoteRequests   QuoteRequest[]
  reviews         Review[]
  agent           Agent?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model UserProfile {
  id                   String       @id @default(uuid()) @db.Uuid
  userId               String       @unique @db.Uuid
  homeLocationId       String?      @db.Uuid
  interests            String[]     @default([])
  pace                 TravelPace   @default(BALANCED)
  dietaryPreference    String?
  budgetBand           String?
  preferredTravelMode  TravelMode?
  defaultUserVehicleId String?      @db.Uuid
  marketingOptIn       Boolean      @default(false)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeLocation         Location?    @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  defaultUserVehicle   UserVehicle? @relation(fields: [defaultUserVehicleId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Vehicle {
  id             String        @id @default(uuid()) @db.Uuid
  brand          String
  model          String
  type           VehicleType
  fuelType       FuelType
  engineCc       Int?
  tankCapacity   Float?
  averageMileage Float?
  userVehicles   UserVehicle[]
  trips          Trip[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model UserVehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  vehicleId          String        @db.Uuid
  nickname           String?
  customMileage      Float?
  registrationNumber String?
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  trips              Trip[]
  defaultForProfiles UserProfile[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([vehicleId])
}

model Destination {
  id               String                 @id @default(uuid()) @db.Uuid
  name             String
  slug             String                 @unique
  state            String
  country          String                 @default("India")
  latitude         Decimal                @db.Decimal(9, 6)
  longitude        Decimal                @db.Decimal(9, 6)
  shortDescription String
  heroImageUrl     String?
  bestTimeToVisit  String?
  places           Place[]
  tagline          String?
  overview         String?
  rating           Decimal?               @db.Decimal(2, 1)
  idealDaysMin     Int?
  idealDaysMax     Int?
  budgetPerDayMin  Int?
  budgetPerDayMax  Int?
  altitudeM        Int?
  nearestAirport   String?
  nearestAirportKm Int?
  nearestRailway   String?
  nearestRailwayKm Int?
  popularityScore  Int                    @default(0)
  isFeatured       Boolean                @default(false)
  status           ContentStatus          @default(DRAFT)
  publishedAt      DateTime?
  seoTitle         String?                @db.VarChar(70)
  seoDescription   String?                @db.VarChar(170)
  tags             DestinationTag[]
  months           DestinationMonthInfo[]
  howToReach       HowToReach[]
  faqs             Faq[]
  media            MediaAttachment[]
  collectionItems  CollectionItem[]
  packageStops     PackageDestination[]
  packageStays     PackageStay[]
  packageDays      PackageDay[]
  quoteRequests    QuoteRequest[]
  reviews          Review[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status, state])
  @@index([status, popularityScore])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Destination_name_trgm_idx")
}

model Location {
  id             String         @id @default(uuid()) @db.Uuid
  name           String
  slug           String         @unique
  state          String
  country        String         @default("India")
  latitude       Decimal        @db.Decimal(9, 6)
  longitude      Decimal        @db.Decimal(9, 6)
  isActive       Boolean        @default(true)
  homeOfProfiles UserProfile[]
  aliases        String[]       @default([])
  popularity     Int            @default(0)
  quoteRequests  QuoteRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  packages       Package[]

  @@index([state])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_trgm_idx")
}

model Place {
  id                     String            @id @default(uuid()) @db.Uuid
  destinationId          String            @db.Uuid
  name                   String
  slug                   String
  category               PlaceCategory
  description            String
  latitude               Decimal           @db.Decimal(9, 6)
  longitude              Decimal           @db.Decimal(9, 6)
  averageVisitMinutes    Int?
  estimatedCost          Decimal?          @db.Decimal(10, 2)
  openingTime            String?
  closingTime            String?
  rating                 Decimal?          @db.Decimal(2, 1)
  destination            Destination       @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tripActivities         TripActivity[]
  overview               String?
  rankInDestination      Int?
  timeRequiredMinMinutes Int?
  timeRequiredMaxMinutes Int?
  entryFeeIndian         Decimal?          @db.Decimal(10, 2)
  entryFeeChild          Decimal?          @db.Decimal(10, 2)
  entryFeeForeigner      Decimal?          @db.Decimal(10, 2)
  feeNotes               String?
  isFree                 Boolean           @default(false)
  bestTimeOfDay          String?
  tips                   String[]          @default([])
  address                String?
  status                 ContentStatus     @default(DRAFT)
  publishedAt            DateTime?
  seoTitle               String?           @db.VarChar(70)
  seoDescription         String?           @db.VarChar(170)
  timings                PlaceTiming[]
  tags                   PlaceTag[]
  faqs                   Faq[]
  media                  MediaAttachment[]
  collectionItems        CollectionItem[]
  packageDays            PackageDayPlace[]
  reviews                Review[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([destinationId, slug])
  @@index([destinationId])
  @@index([destinationId, status, rankInDestination])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Place_name_trgm_idx")
}

model Trip {
  id                       String          @id @default(uuid()) @db.Uuid
  userId                   String?         @db.Uuid
  title                    String
  sourceName               String
  sourceLatitude           Decimal         @db.Decimal(9, 6)
  sourceLongitude          Decimal         @db.Decimal(9, 6)
  destinationName          String
  destinationLatitude      Decimal         @db.Decimal(9, 6)
  destinationLongitude     Decimal         @db.Decimal(9, 6)
  startDate                DateTime        @db.Date
  endDate                  DateTime        @db.Date
  travellerCount           Int
  travelMode               TravelMode
  budget                   Decimal?        @db.Decimal(10, 2)
  interests                String[]        @default([])
  preferences              String[]        @default([])
  notes                    String?
  vehicleId                String?         @db.Uuid
  userVehicleId            String?         @db.Uuid
  visibility               TripVisibility  @default(PRIVATE)
  shareSlug                String?         @unique
  status                   TripStatus      @default(DRAFT)
  estimatedDistanceKm      Decimal?        @db.Decimal(10, 2)
  estimatedDurationMinutes Int?
  estimatedTotalCost       Decimal?        @db.Decimal(10, 2)
  estimatedFuelCost        Decimal?        @db.Decimal(10, 2)
  user                     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle                  Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  userVehicle              UserVehicle?    @relation(fields: [userVehicleId], references: [id], onDelete: SetNull)
  travellers               TripTraveller[]
  days                     TripDay[]
  savedBy                  SavedItem[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([userId])
  @@index([vehicleId])
  @@index([userVehicleId])
}

model SavedItem {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      SavedItemType
  tripId    String?       @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, tripId])
  @@index([userId, type, createdAt])
}

model TripTraveller {
  id        String          @id @default(uuid()) @db.Uuid
  tripId    String          @db.Uuid
  fullName  String
  age       Int
  gender    TravellerGender
  sortOrder Int
  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tripId])
}

model TripDay {
  id                  String         @id @default(uuid()) @db.Uuid
  tripId              String         @db.Uuid
  dayNumber           Int
  date                DateTime       @db.Date
  title               String
  description         String?
  estimatedDistanceKm Decimal?       @db.Decimal(10, 2)
  estimatedCost       Decimal?       @db.Decimal(10, 2)
  trip                Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities          TripActivity[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model TripActivity {
  id                            String           @id @default(uuid()) @db.Uuid
  tripDayId                     String           @db.Uuid
  placeId                       String?          @db.Uuid
  title                         String
  description                   String?
  activityType                  TripActivityType
  startTime                     String?
  endTime                       String?
  latitude                      Decimal?         @db.Decimal(9, 6)
  longitude                     Decimal?         @db.Decimal(9, 6)
  estimatedCost                 Decimal?         @db.Decimal(10, 2)
  distanceFromPreviousKm        Decimal?         @db.Decimal(10, 2)
  travelTimeFromPreviousMinutes Int?
  sortOrder                     Int
  tripDay                       TripDay          @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  place                         Place?           @relation(fields: [placeId], references: [id], onDelete: SetNull)
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  @@index([tripDayId])
  @@index([placeId])
}

model PlaceTiming {
  id        String  @id @default(uuid()) @db.Uuid
  placeId   String  @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int
  /// "HH:mm", 24-hour, India time. Null when closed.
  opensAt   String?
  closesAt  String?
  isClosed  Boolean @default(false)
  place     Place   @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, dayOfWeek])
}

model Tag {
  id           String           @id @default(uuid()) @db.Uuid
  slug         String           @unique
  name         String
  kind         TagKind          @default(THEME)
  description  String?
  destinations DestinationTag[]
  places       PlaceTag[]
  packages     PackageTag[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model DestinationTag {
  destinationId String      @db.Uuid
  tagId         String      @db.Uuid
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([destinationId, tagId])
  @@index([tagId])
}

model PlaceTag {
  placeId String @db.Uuid
  tagId   String @db.Uuid
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([placeId, tagId])
  @@index([tagId])
}

model DestinationMonthInfo {
  id            String      @id @default(uuid()) @db.Uuid
  destinationId String      @db.Uuid
  /// 1 = January … 12 = December
  month         Int
  rating        MonthRating
  avgMinC       Int?
  avgMaxC       Int?
  rainfallMm    Int?
  notes         String?
  events        String[]    @default([])
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, month])
  @@index([month, rating])
}

model HowToReach {
  id              String      @id @default(uuid()) @db.Uuid
  destinationId   String      @db.Uuid
  mode            ReachMode
  hubName         String
  distanceKm      Int?
  durationMinutes Int?
  costMin         Int?
  costMax         Int?
  summary         String
  sortOrder       Int         @default(0)
  destination     Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
}

model Faq {
  id            String       @id @default(uuid()) @db.Uuid
  destinationId String?      @db.Uuid
  placeId       String?      @db.Uuid
  packageId     String?      @db.Uuid
  question      String
  answer        String
  sortOrder     Int          @default(0)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  place         Place?       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  package       Package?     @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
  @@index([placeId, sortOrder])
  @@index([packageId, sortOrder])
}

model Collection {
  id             String            @id @default(uuid()) @db.Uuid
  slug           String            @unique
  title          String
  intro          String
  body           String?
  isFeatured     Boolean           @default(false)
  status         ContentStatus     @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?           @db.VarChar(70)
  seoDescription String?           @db.VarChar(170)
  items          CollectionItem[]
  media          MediaAttachment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, isFeatured])
}

model CollectionItem {
  id            String       @id @default(uuid()) @db.Uuid
  collectionId  String       @db.Uuid
  destinationId String?      @db.Uuid
  placeId       String?      @db.Uuid
  blurb         String?
  sortOrder     Int          @default(0)
  collection    Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  place         Place?       @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([collectionId, sortOrder])
}

model Media {
  id           String            @id @default(uuid()) @db.Uuid
  /// Set for files stored by this API; null for registered external URLs.
  storageKey   String?           @unique
  url          String
  mimeType     String?
  width        Int?
  height       Int?
  bytes        Int?
  altText      String
  credit       String?
  /// OWNED | CC-BY | CC-BY-SA | CC0 | LICENSED
  license      String
  sourceUrl    String?
  uploadedById String?           @db.Uuid
  attachments  MediaAttachment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([createdAt])
}

model MediaAttachment {
  id            String       @id @default(uuid()) @db.Uuid
  mediaId       String       @db.Uuid
  destinationId String?      @db.Uuid
  placeId       String?      @db.Uuid
  collectionId  String?      @db.Uuid
  packageId     String?      @db.Uuid
  isCover       Boolean      @default(false)
  sortOrder     Int          @default(0)
  media         Media        @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  place         Place?       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  collection    Collection?  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  package       Package?     @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([destinationId, sortOrder])
  @@index([placeId, sortOrder])
  @@index([collectionId, sortOrder])
  @@index([packageId, sortOrder])
}

model SlugRedirect {
  id         String   @id @default(uuid()) @db.Uuid
  /// DESTINATION | PLACE | COLLECTION
  entityType String
  /// Parent slug for places (their URL includes the destination); empty otherwise.
  scope      String   @default("")
  fromSlug   String
  toSlug     String
  createdAt  DateTime @default(now())

  @@unique([entityType, scope, fromSlug])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  summary    String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ───────────────────────── Packages ─────────────────────────

model Package {
  id              String               @id @default(uuid()) @db.Uuid
  slug            String               @unique
  title           String
  summary         String
  overview        String?
  durationDays    Int
  durationNights  Int
  startLocationId String?              @db.Uuid
  /// Lowest tier price per person; kept in sync on save for sorting and filtering.
  fromPrice       Int?
  priceBasis      String               @default("PER_PERSON_TWIN_SHARING")
  /// Months (1–12) the package runs; empty means all year.
  availableMonths Int[]                @default([])
  minPax          Int                  @default(1)
  maxPax          Int?
  isCustomizable  Boolean              @default(true)
  rating          Decimal?             @db.Decimal(2, 1)
  reviewCount     Int                  @default(0)
  popularityScore Int                  @default(0)
  isFeatured      Boolean              @default(false)
  status          ContentStatus        @default(DRAFT)
  publishedAt     DateTime?
  seoTitle        String?              @db.VarChar(70)
  seoDescription  String?              @db.VarChar(170)
  startLocation   Location?            @relation(fields: [startLocationId], references: [id], onDelete: SetNull)
  destinations    PackageDestination[]
  tiers           PackageTier[]
  days            PackageDay[]
  stays           PackageStay[]
  inclusions      PackageInclusion[]
  policies        PackagePolicy[]
  tags            PackageTag[]
  faqs            Faq[]
  media           MediaAttachment[]
  reviews         Review[]
  quoteRequests   QuoteRequest[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, fromPrice])
  @@index([status, durationNights])
  @@index([status, popularityScore])
}

/// Route summary, e.g. Manali 2N → Kasol 1N.
model PackageDestination {
  id            String      @id @default(uuid()) @db.Uuid
  packageId     String      @db.Uuid
  destinationId String      @db.Uuid
  nights        Int
  sortOrder     Int
  package       Package     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([packageId, sortOrder])
  @@index([destinationId])
}

model PackageTier {
  id               String           @id @default(uuid()) @db.Uuid
  packageId        String           @db.Uuid
  level            PackageTierLevel
  pricePerPerson   Int
  /// Only set when there really was a higher earlier price.
  compareAtPrice   Int?
  childPrice       Int?
  singleSupplement Int?
  taxesIncluded    Boolean          @default(false)
  hotelCategory    Int?
  transportNote    String?
  package          Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, level])
}

model PackageDay {
  id                     String            @id @default(uuid()) @db.Uuid
  packageId              String            @db.Uuid
  dayNumber              Int
  title                  String
  description            String
  overnightDestinationId String?           @db.Uuid
  /// Any of B (breakfast), L (lunch), D (dinner).
  mealsIncluded          String[]          @default([])
  package                Package           @relation(fields: [packageId], references: [id], onDelete: Cascade)
  overnightDestination   Destination?      @relation(fields: [overnightDestinationId], references: [id], onDelete: SetNull)
  places                 PackageDayPlace[]

  @@unique([packageId, dayNumber])
}

model PackageDayPlace {
  packageDayId String     @db.Uuid
  placeId      String     @db.Uuid
  sortOrder    Int
  day          PackageDay @relation(fields: [packageDayId], references: [id], onDelete: Cascade)
  place        Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([packageDayId, placeId])
}

model PackageStay {
  id            String           @id @default(uuid()) @db.Uuid
  packageId     String           @db.Uuid
  tierLevel     PackageTierLevel
  destinationId String           @db.Uuid
  nights        Int
  hotelName     String
  orSimilar     Boolean          @default(true)
  hotelCategory Int?
  roomType      String?
  mealPlan      MealPlan
  sortOrder     Int              @default(0)
  package       Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination   Destination      @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([packageId, tierLevel, sortOrder])
}

model PackageInclusion {
  id        String        @id @default(uuid()) @db.Uuid
  packageId String        @db.Uuid
  type      InclusionType
  text      String
  sortOrder Int           @default(0)
  package   Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, type, sortOrder])
}

model PackagePolicy {
  id        String     @id @default(uuid()) @db.Uuid
  packageId String     @db.Uuid
  kind      PolicyKind
  body      String
  package   Package    @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, kind])
}

model PackageTag {
  packageId String  @db.Uuid
  tagId     String  @db.Uuid
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([packageId, tagId])
  @@index([tagId])
}

// ───────────────────────── Quotes ─────────────────────────

/// A travel agency that can receive quote requests. Managed by admins; an agency
/// may have one linked user account (role AGENT) to answer requests in the app.
model Agent {
  id            String              @id @default(uuid()) @db.Uuid
  slug          String              @unique
  displayName   String
  email         String
  phone         String
  city          String?
  /// State names served; empty means all of India.
  serviceStates String[]            @default([])
  isActive      Boolean             @default(true)
  maxOpenLeads  Int                 @default(20)
  lastRoutedAt  DateTime?
  notes         String?
  userId        String?             @unique @db.Uuid
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  routings      QuoteRequestAgent[]
  quotes        Quote[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([isActive, lastRoutedAt])
}

model QuoteRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  packageId           String?             @db.Uuid
  packageTier         PackageTierLevel?
  destinationId       String?             @db.Uuid
  departureLocationId String?             @db.Uuid
  startDate           DateTime?           @db.Date
  /// 1–12 when the traveller's dates are flexible.
  flexibleMonth       Int?
  nights              Int
  adults              Int
  childAges           Int[]               @default([])
  rooms               Int
  budgetPerPersonMin  Int?
  budgetPerPersonMax  Int?
  hotelCategory       Int?
  notes               String?
  contactName         String
  /// E.164, verified by OTP before the request is created.
  contactPhone        String
  contactEmail        String?
  phoneVerifiedAt     DateTime
  consentAt           DateTime
  /// PACKAGE | DESTINATION | TRIP | DIRECT
  source              String
  status              QuoteRequestStatus  @default(NEW)
  expiresAt           DateTime
  closedReason        String?
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  package             Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  destination         Destination?        @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  departureLocation   Location?           @relation(fields: [departureLocationId], references: [id], onDelete: SetNull)
  routings            QuoteRequestAgent[]
  quotes              Quote[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model QuoteRequestAgent {
  quoteRequestId String             @db.Uuid
  agentId        String             @db.Uuid
  status         QuoteRoutingStatus @default(NOTIFIED)
  notifiedAt     DateTime           @default(now())
  viewedAt       DateTime?
  respondedAt    DateTime?
  declineReason  String?
  request        QuoteRequest       @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  agent          Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([quoteRequestId, agentId])
  @@index([agentId, status])
}

model Quote {
  id              String            @id @default(uuid()) @db.Uuid
  quoteRequestId  String            @db.Uuid
  agentId         String            @db.Uuid
  tier            PackageTierLevel?
  totalPrice      Int
  pricePerPerson  Int
  taxesIncluded   Boolean
  /// [{ destinationName, hotelName, hotelCategory, mealPlan, nights }]
  hotels          Json
  inclusions      String[]          @default([])
  exclusions      String[]          @default([])
  message         String?
  validUntil      DateTime
  status          QuoteStatus       @default(SENT)
  createdByUserId String?           @db.Uuid
  request         QuoteRequest      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  agent           Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([quoteRequestId, agentId])
  @@index([agentId, status])
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

// ───────────────────────── Reviews ─────────────────────────

model Review {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  packageId      String?        @db.Uuid
  destinationId  String?        @db.Uuid
  placeId        String?        @db.Uuid
  rating         Int
  title          String?        @db.VarChar(120)
  body           String
  /// First day of the month travelled.
  travelledMonth DateTime?      @db.Date
  travellerType  TravellerType?
  /// Reviewer accepted a quote for this package through the platform.
  isVerified     Boolean        @default(false)
  status         ReviewStatus   @default(PENDING)
  moderationNote String?
  moderatedById  String?        @db.Uuid
  moderatedAt    DateTime?
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  package        Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  destination    Destination?   @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  place          Place?         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([userId, packageId])
  @@unique([userId, destinationId])
  @@unique([userId, placeId])
  @@index([packageId, status, createdAt])
  @@index([destinationId, status, createdAt])
  @@index([placeId, status, createdAt])
  @@index([status, createdAt])
}
